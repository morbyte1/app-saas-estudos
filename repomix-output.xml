})

test('barras de questões usam composição de acertos e erros por bloco', () => {
  const pontos = pontosEvolucao([sessao('2026-09-01', 10, 2), sessao('2026-09-07', 5, 3), sessao('2026-09-08', 4, 0)], '30', '2026-08-21', '2026-09-19')
