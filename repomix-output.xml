    'Atrasado': 'bg-red-100 text-red-700',
    'Meta alcançada': 'bg-emerald-100 text-emerald-700'
  }
  return (
    <span className={`text-[10px] font-bold px-2 py-1 rounded-md uppercase tracking-wider ${styles[status]}`}>
      {status}
    </span>
  )
}

