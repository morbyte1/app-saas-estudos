  assert.equal(diferencaPrecisao(resumirSessoes([sessao('2026-09-19', 20, 4)]), resumirSessoes([sessao('2026-09-12', 20, 6)])), 10)
})

test('gráfico mantém dias sem sessões e não inventa precisão nesses dias', () => {
