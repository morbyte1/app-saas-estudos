    'CREATE TABLE public.caderno_revisoes (
       id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
       user_id %s NOT NULL,
       erro_id %s NOT NULL REFERENCES public.caderno_erros(id) ON DELETE CASCADE,
